<Window x:Class="AutoLockerScreenEx.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto-lock warning" Width="480" Height="190"
        Topmost="True" WindowStartupLocation="Manual" ResizeMode="NoResize"
        BorderBrush="Red" BorderThickness="3">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SCREEN AUTO-LOCK IS OFF!" Foreground="Red"
                   FontSize="20" FontWeight="Bold"/>

        <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap"
                   VerticalAlignment="Center" FontSize="13"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Open settings" Click="Open_Click" Margin="0,0,4,0"/>
            <Button Grid.Column="1" Content="Dismiss" Click="Dismiss_Click" Margin="4,0,0,0"/>
        </Grid>
    </Grid>
</Window>
