<Window x:Class="AutoLockerScreenEx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Locker Screen" Width="400" Height="280"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Click Check to see the current auto-lock status."/>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Text="AC - plugged in (seconds, 0 = never):"/>
            <TextBox x:Name="AcBox" Grid.Column="1" Width="80" Text="0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Text="DC - on battery (seconds, 0 = never):"/>
            <TextBox x:Name="DcBox" Grid.Column="1" Width="80" Text="0"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="MonitorBox" Grid.Column="0" VerticalAlignment="Center"
                      Content="Monitor every" Checked="Monitor_Changed" Unchecked="Monitor_Changed"/>
            <TextBox x:Name="IntervalBox" Grid.Column="1" Width="50" Margin="6,0" Text="60"
                     TextChanged="Monitor_Changed"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="sec; warn if lock is off"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Check" Click="Check_Click" Margin="0,0,4,0"/>
            <Button Grid.Column="1" Content="Set" Click="Set_Click" Margin="4,0,0,0"/>
        </Grid>
    </Grid>
</Window>
